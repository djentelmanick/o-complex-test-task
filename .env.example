# Ключ для доступа к API и демо-странице (не короче 16 символов)
APP_API_KEY=change-me-to-a-long-random-string
# Пароль Postgres (только буквы и цифры — он подставляется в URL)
POSTGRES_PASSWORD=changeme123

# gigachat | fake (fake — запуск без ключа GigaChat)
LLM_PROVIDER=gigachat
# Ключ авторизации из личного кабинета GigaChat API (Basic, base64)
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Pro

# local | gigachat | fake. local — модель, вшитая в образ; эмбеддинги GigaChat платные
EMBEDDING_PROVIDER=local
# Размерность должна совпадать с моделью: 384 для local, 1024 для gigachat (Embeddings)
EMBEDDING_DIM=384

RETRIEVAL_MIN_SCORE=0.3
RATE_LIMIT=10/minute

# mock | amocrm
CRM_PROVIDER=mock
# Для CRM_PROVIDER=amocrm (внешняя интеграция AmoCRM, вкладка «Ключи и доступы»)
AMOCRM_SUBDOMAIN=
AMOCRM_CLIENT_ID=
AMOCRM_CLIENT_SECRET=
AMOCRM_REDIRECT_URI=https://example.com
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AMOCRM_TOKEN_KEY=
# python -c "import secrets; print(secrets.token_urlsafe(32))"
AMOCRM_WEBHOOK_SECRET=
AMOCRM_TUNNEL_METRICS_URL=http://tunnel:4040/api/tunnels
# Токен ngrok (dashboard.ngrok.com → Your Authtoken) для публичного адреса вебхука
NGROK_AUTHTOKEN=
